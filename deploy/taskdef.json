{
  "family": "assistant-todo",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<ecsTaskExecutionRole>",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<assistantTodoTaskRole>",
  "containerDefinitions": [
    {
      "name": "assistant-todo",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/assistant-todo:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" },
        { "name": "MARIADB_HOST", "value": "<db-host>" },
        { "name": "MARIADB_PORT", "value": "3306" },
        { "name": "MARIADB_DATABASE", "value": "assistant_todo" },
        { "name": "MARIADB_USER", "value": "assistant_todo" },
        { "name": "MARIADB_SSL", "value": "true" },
        { "name": "MARIADB_POOL_SIZE", "value": "10" },
        { "name": "S3_BUCKET", "value": "<attachment-bucket>" },
        { "name": "S3_REGION", "value": "<REGION>" },
        { "name": "SMTP_HOST", "value": "<mail-host>" },
        { "name": "SMTP_PORT", "value": "25" },
        { "name": "SMTP_SECURE", "value": "false" },
        { "name": "SMTP_FROM", "value": "전략 Assistant <no-reply@사내도메인>" }
      ],
      "secrets": [
        {
          "name": "MARIADB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:assistant-todo/db:password::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/assistant-todo",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "stopTimeout": 30
    }
  ]
}
