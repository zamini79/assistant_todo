# Supabase 연결 정보.
#
# 이 파일을 .env.local로 복사하고 값을 채우면 자동으로 Supabase 리포지토리가 선택된다.
# 비워두면 인메모리 리포지토리(lib/seed/todos.ts의 시드 26건)로 동작하므로
# 크리덴셜 없이도 앱 전체를 실행·시연할 수 있다.
#
# 판정 로직: lib/repository/index.ts의 readSupabaseEnv()

# ── 권장 (접두사 없음) ────────────────────────────────────────
# Supabase는 서버에서만 호출하므로 NEXT_PUBLIC_ 접두사가 필요 없다.
# 접두사를 붙이면 Next.js가 빌드 시점에 값을 번들에 박아버려,
# 배포 후 환경변수를 바꿔도 반영되지 않는 함정이 생긴다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 서버 전용. 설정하면 anon 키 대신 이 키를 쓴다.
# RLS를 우회하므로 절대 클라이언트로 노출하지 말 것 (NEXT_PUBLIC_ 접두사 금지).
SUPABASE_SERVICE_ROLE_KEY=

# ── 호환 (기존 설정을 쓰는 경우) ──────────────────────────────
# 아래 이름도 계속 인식한다. 위 항목이 있으면 위가 우선한다.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 메일 발송 (Remind) ────────────────────────────────────────
# 경로가 둘이다. 둘 다 있으면 HTTP API가 쓰인다.
#
# (1) HTTP API — SMTP 포트가 막힌 곳에서 쓴다.
#     Render 무료 플랜은 아웃바운드 25·465·587을 차단하므로 SMTP로는 못 보낸다.
#     443은 열려 있어 이 경로는 나간다.
#
#     발신 주소는 Resend에 등록·인증한 도메인의 주소여야 한다.
#     gmail.com 같은 남의 도메인을 쓰면 DKIM이 어긋나 수신 측에서 걸러진다.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=전략 Assistant <no-reply@내도메인>
#
# 사내 메일서버로 이관할 때는 RESEND_API_KEY를 빼면 아래 SMTP로 되돌아온다.
#
# (2) SMTP — 벤더 중립 설정. Gmail로 시작하고, 사내 메일서버로 옮길 때는
# 아래 값만 교체하면 된다 — 코드는 그대로다.
#
# Gmail: 2단계 인증을 켠 뒤 "앱 비밀번호"(16자)를 발급해 SMTP_PASS에 넣는다.
#        계정 비밀번호로는 로그인되지 않는다.
#        https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=
# 표시될 발신자. 생략하면 SMTP_USER를 쓴다.
SMTP_FROM=전략 Assistant <your-account@gmail.com>
# 생략 시 PORT 465는 implicit TLS, 그 외는 STARTTLS로 본다.
# SMTP_SECURE=true
#
# 사내 메일서버로 전환할 때 예시:
#   SMTP_HOST=mail.사내도메인
#   SMTP_PORT=587
#   SMTP_SECURE=false
