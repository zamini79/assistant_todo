# Supabase 연결 정보.
#
# 이 파일을 .env.local로 복사하고 값을 채우면 자동으로 Supabase 리포지토리가 선택된다.
# 비워두면 인메모리 리포지토리(lib/seed/todos.ts의 시드 26건)로 동작하므로
# 크리덴셜 없이도 앱 전체를 실행·시연할 수 있다.
#
# 판정 로직: lib/repository/index.ts의 readSupabaseEnv()

# ── 권장 (접두사 없음) ────────────────────────────────────────
# Supabase는 서버에서만 호출하므로 NEXT_PUBLIC_ 접두사가 필요 없다.
# 접두사를 붙이면 Next.js가 빌드 시점에 값을 번들에 박아버려,
# 배포 후 환경변수를 바꿔도 반영되지 않는 함정이 생긴다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 서버 전용. 설정하면 anon 키 대신 이 키를 쓴다.
# RLS를 우회하므로 절대 클라이언트로 노출하지 말 것 (NEXT_PUBLIC_ 접두사 금지).
SUPABASE_SERVICE_ROLE_KEY=

# ── 호환 (기존 설정을 쓰는 경우) ──────────────────────────────
# 아래 이름도 계속 인식한다. 위 항목이 있으면 위가 우선한다.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
